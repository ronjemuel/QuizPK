<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/screen_padding" android:orientation="vertical"><TextView android:id="@+id/question_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.QuizPK.Label"/>
<ProgressBar android:id="@+id/quiz_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:progressTint="@color/primary"/>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp"><ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_clock" android:importantForAccessibility="no"/><TextView android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/accent_text"/><TextView android:id="@+id/timer_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:textAppearance="@style/Text.QuizPK.Body"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<TextView android:id="@+id/question_category" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textAppearance="@style/Text.QuizPK.Label"/>
<TextView android:id="@+id/question_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/Text.QuizPK.Title" android:textSize="24sp"/>
<LinearLayout android:id="@+id/answer_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/resume_question" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/resume_quiz"/>
<com.google.android.material.button.MaterialButton android:id="@+id/submit_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="@string/submit_answer"/>
<com.google.android.material.button.MaterialButton android:id="@+id/skip_question" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/skip_question"/>
<TextView android:id="@+id/answer_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textAppearance="@style/Text.QuizPK.Section" android:accessibilityLiveRegion="polite"/>
<TextView android:id="@+id/answer_explanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/Text.QuizPK.Body"/>
<com.google.android.material.button.MaterialButton android:id="@+id/next_question" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="16dp" android:text="@string/next_question"/></LinearLayout></androidx.core.widget.NestedScrollView>
