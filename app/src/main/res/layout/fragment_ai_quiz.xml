<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/ai_create_tab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ai_create_tab" />
        <com.google.android.material.button.MaterialButton android:id="@+id/ai_saved_tab" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/ai_saved_tab" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/ai_form_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="16dp" android:src="@drawable/ic_sparkles" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ai_create_title" android:textAppearance="@style/Text.QuizPK.Title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ai_create_body" android:textAppearance="@style/Text.QuizPK.Body" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/ai_topic_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="@string/ai_topic_label" app:counterEnabled="true" app:counterMaxLength="120">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/ai_topic" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLength="120" android:maxLines="3" android:minHeight="56dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/ai_difficulty" android:text="@string/difficulty" android:textAppearance="@style/Text.QuizPK.Section" />
            <Spinner android:id="@+id/ai_difficulty" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:labelFor="@id/ai_count" android:text="@string/ai_count_label" android:textAppearance="@style/Text.QuizPK.Body" />
            <Spinner android:id="@+id/ai_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:labelFor="@id/ai_timer" android:text="@string/ai_timer_label" android:textAppearance="@style/Text.QuizPK.Body" />
            <Spinner android:id="@+id/ai_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/ai_instructions_label" app:counterEnabled="true" app:counterMaxLength="500">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/ai_instructions" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:maxLength="500" android:minLines="2" android:gravity="top|start" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardBackgroundColor="@color/surface_variant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <ProgressBar android:id="@+id/ai_progress" android:layout_width="match_parent" android:layout_height="wrap_content" style="?android:attr/progressBarStyleHorizontal" android:indeterminate="true" android:visibility="gone" />
                    <TextView android:id="@+id/ai_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ai_ready" android:textAppearance="@style/Text.QuizPK.Body" android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/generate_quiz" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/generate_quiz" app:icon="@drawable/ic_sparkles" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/ai_cancel" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_cancel_label" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/ai_play_generated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_play_label" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/ai_review_notice" android:textAppearance="@style/Text.QuizPK.Body" />
            <com.google.android.material.button.MaterialButton android:id="@+id/ai_connect" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_connect_label" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/ai_saved_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/ai_saved_title" android:textAppearance="@style/Text.QuizPK.Title" />
        <TextView android:id="@+id/ai_saved_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:textAppearance="@style/Text.QuizPK.Body" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/ai_saved_retry" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_reload" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/ai_saved_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="20dp" />
    </LinearLayout>
</LinearLayout>
